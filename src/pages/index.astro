---
import '../styles/global.css';
import { filters, projects as projectRecords } from '../data/projects';

const projects = projectRecords.map((project) => ({
  ...project,
  mediaFaces: [project.media.audio, project.media.video].filter(Boolean),
})).sort((left, right) => {
  const yearDifference = right.timelineYear - left.timelineYear;
  return yearDifference || left.id - right.id;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Selected work in sound, image and space." />
    <title>Alastair McNeill / Yila</title>
  </head>
  <body>
    <main class="project-field" aria-label="Alastair McNeill project archive">
      <nav class="filter-nav" aria-label="Filter projects">
        {filters.map(({ id, label }) => {
          const filterProjects = id === 'all' ? projects : projects.filter((project) => project.categories.includes(id));
          return <button class={`filter-cube filter-${id}${id === 'all' ? ' is-active' : ''}`} type="button" data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'} aria-label={`Show ${filterProjects.length} ${label.toLowerCase()} projects`}>
            <span class="filter-count" aria-hidden="true">
              {filterProjects.map((project) => <i style={`background-image: url(${project.image})`}></i>)}
            </span>
            <span class="filter-label">{label}</span>
          </button>;
        })}
      </nav>

      <section class="project-grid">
        {projects.map((project) => {
          const [firstMedia, secondMedia] = project.mediaFaces;
          const firstVideoId = firstMedia?.provider === 'youtube' ? firstMedia.src.match(/embed\/([^?]+)/)?.[1] : undefined;
          const secondVideoId = secondMedia?.provider === 'youtube' ? secondMedia.src.match(/embed\/([^?]+)/)?.[1] : undefined;
          const videoPosition = firstMedia && ['youtube', 'vimeo'].includes(firstMedia.provider)
            ? 3
            : secondMedia && ['youtube', 'vimeo'].includes(secondMedia.provider)
              ? 4
              : undefined;
          return <article class="slice" data-project={project.id} data-categories={project.categories.join(' ')} data-atmos={firstMedia?.provider === 'atmos' ? 'true' : 'false'}>
            <div class="slab">
              <button class="face front" type="button" data-action="info" aria-label={`Show information for ${project.title}`}>
                <img src={project.image} alt="" loading={project.id === 0 ? 'eager' : 'lazy'} fetchpriority={project.id === 0 ? 'high' : 'auto'} decoding="async" />
              </button>
              <button class="face right" type="button" data-action="media" data-media-count={project.mediaFaces.length} aria-label={project.mediaFaces.length ? `Show media for ${project.title}` : `Project information for ${project.title}`}>
                <strong>{project.title}</strong>
                <small>
                  {project.role.split(' · ').map((role) => (
                    <span>{role}</span>
                  ))}
                </small>
                <em>{project.summary}</em>
              </button>
              <div class="face left media-face neutral" data-position="4" style={`background-image: url(${project.image})`}>
                {secondMedia && <div class="media-slot" data-position="4" data-provider={secondMedia.provider} data-src={secondMedia.src} data-image={project.image} data-video-id={secondVideoId} data-title={project.title}></div>}
              </div>
              <div class="face top cube-cap" aria-hidden="true"></div>
              <div class="face bottom cube-cap" aria-hidden="true"></div>
              <div class="face back media-face neutral" data-position="3" data-has-next={secondMedia ? 'true' : 'false'} style={`background-image: url(${project.image})`}>
                {firstMedia && <div class="media-slot" data-position="3" data-provider={firstMedia.provider} data-src={firstMedia.src} data-image={project.image} data-video-id={firstVideoId} data-title={project.title}></div>}
              </div>
            </div>
            <button class="media-advance" type="button" aria-label={project.mediaFaces.length ? `Show media for ${project.title}` : `Reset ${project.title}`}></button>
            {videoPosition && <button class="video-expand" type="button" data-video-position={videoPosition} aria-label={`Expand ${project.title} video`}>[ ]</button>}
          </article>;
        })}
      </section>
    </main>

    <script>
      const main = document.querySelector('.project-field');
      const cubes = [...document.querySelectorAll('.slice')];
      const positions = ['is-info', 'is-media-1', 'is-media-2'];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mediaLoadTimers = new WeakMap();
      const interactionTimers = new WeakMap();
      const lockedCubes = new WeakSet();
      let isFiltering = false;
      let activeFilter = 'all';

      function clearSlot(slot) {
        slot.replaceChildren();
      }

      function resetCube(cube) {
        window.clearTimeout(mediaLoadTimers.get(cube));
        window.clearTimeout(interactionTimers.get(cube));
        mediaLoadTimers.delete(cube);
        interactionTimers.delete(cube);
        lockedCubes.delete(cube);
        cube.classList.remove(...positions, 'is-atmos');
        cube.querySelectorAll('.media-slot').forEach(clearSlot);
      }

      function lockCube(cube) {
        if (reduceMotion) return;
        window.clearTimeout(interactionTimers.get(cube));
        lockedCubes.add(cube);
        const timer = window.setTimeout(() => {
          lockedCubes.delete(cube);
          interactionTimers.delete(cube);
        }, 420);
        interactionTimers.set(cube, timer);
      }

      function resetProjects() {
        cubes.forEach(resetCube);
      }

      function openVideoZoom(slot) {
        const player = slot.querySelector('.embedded-player');
        if (!(player instanceof HTMLElement)) return;
        // Keep dismissal under our control. Native `auto` light-dismiss can close
        // the popover before the outside click reaches this script, allowing the
        // click to fall through to the cube and reset its media face.
        player.setAttribute('popover', 'manual');
        player.classList.add('video-zoomed');
        player.showPopover();
      }

      function resumeVideoPlayer(player) {
        const frame = player.querySelector('iframe');
        const slot = player.closest('.media-slot');
        if (!(frame instanceof HTMLIFrameElement) || !(slot instanceof HTMLElement)) return;
        const targetOrigin = new URL(frame.src).origin;
        const message = slot.dataset.provider === 'youtube'
          ? JSON.stringify({ event: 'command', func: 'playVideo', args: [] })
          : { method: 'play' };
        frame.contentWindow?.postMessage(message, targetOrigin);
        window.setTimeout(() => frame.contentWindow?.postMessage(message, targetOrigin), 150);
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof Element) {
          const expandButton = target.closest('.video-expand');
          if (expandButton) {
            const cube = expandButton.closest('.slice');
            const slot = cube?.querySelector(`.media-slot[data-position="${expandButton.dataset.videoPosition}"]`);
            event.preventDefault();
            event.stopImmediatePropagation();
            if (slot instanceof HTMLElement) openVideoZoom(slot);
            return;
          }
        }
        const expandedPlayer = document.querySelector('.video-zoomed:popover-open');
        if (expandedPlayer && !event.composedPath().includes(expandedPlayer)) {
          event.stopPropagation();
          if (expandedPlayer instanceof HTMLElement) {
            expandedPlayer.hidePopover();
            resumeVideoPlayer(expandedPlayer);
          }
        }
      }, { capture: true });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const expandedPlayer = document.querySelector('.video-zoomed:popover-open');
        if (!(expandedPlayer instanceof HTMLElement)) return;
        event.preventDefault();
        event.stopPropagation();
        expandedPlayer.hidePopover();
        resumeVideoPlayer(expandedPlayer);
      }, { capture: true });

      function mountEmbed(slot) {
        if (slot.firstChild) return;
        if (slot.dataset.provider === 'youtube' || slot.dataset.provider === 'vimeo') {
          const frame = document.createElement('iframe');
          const player = document.createElement('span');
          const isYoutube = slot.dataset.provider === 'youtube';
          player.className = `embedded-player ${isYoutube ? 'youtube' : 'vimeo'}`;
          player.addEventListener('toggle', (event) => {
            if (event.newState !== 'closed') return;
            player.classList.remove('video-zoomed');
            resumeVideoPlayer(player);
          });
          const videoUrl = new URL(slot.dataset.src);
          videoUrl.searchParams.set('autoplay', '1');
          if (isYoutube) {
            videoUrl.searchParams.set('controls', '0');
            videoUrl.searchParams.set('cc_load_policy', '0');
            videoUrl.searchParams.set('enablejsapi', '1');
            videoUrl.searchParams.set('iv_load_policy', '3');
            videoUrl.searchParams.set('modestbranding', '1');
            videoUrl.searchParams.set('playsinline', '1');
            videoUrl.searchParams.set('rel', '0');
          } else {
            videoUrl.searchParams.set('title', '0');
            videoUrl.searchParams.set('byline', '0');
            videoUrl.searchParams.set('portrait', '0');
          }
          frame.src = videoUrl.toString();
          frame.title = `${slot.dataset.title} video`;
          frame.allow = 'autoplay; encrypted-media; picture-in-picture';
          frame.referrerPolicy = 'strict-origin-when-cross-origin';
          frame.allowFullscreen = true;
          if (isYoutube) frame.addEventListener('load', () => {
            const sendCommand = (func, args = []) => frame.contentWindow?.postMessage(
              JSON.stringify({ event: 'command', func, args }),
              videoUrl.origin,
            );
            sendCommand('playVideo');
            window.setTimeout(() => sendCommand('unloadModule', ['captions']), 100);
            window.setTimeout(() => sendCommand('unloadModule', ['captions']), 800);
          });
          player.append(frame);
          slot.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            const cube = slot.closest('.slice');
            if (cube) resetCube(cube);
          });
          slot.append(player);
          return;
        }
        if (slot.dataset.provider === 'soundcloud') {
          const frame = document.createElement('iframe');
          const player = document.createElement('span');
          player.className = 'embedded-player soundcloud';
          frame.src = slot.dataset.src;
          frame.title = `${slot.dataset.title} audio`;
          frame.allow = 'autoplay';
          player.append(frame);
          const mediaFace = slot.closest('.media-face');
          if (mediaFace?.dataset.hasNext === 'true') {
            const advance = document.createElement('button');
            advance.type = 'button';
            advance.className = 'media-turn';
            advance.setAttribute('aria-label', `Show next media for ${slot.dataset.title}`);
            advance.addEventListener('click', (event) => {
              event.preventDefault();
              event.stopPropagation();
              const cube = slot.closest('.slice');
              if (cube) setCubePosition(cube, 4);
            });
            slot.append(advance, player);
            return;
          }
          slot.append(player);
          return;
        }
        if (slot.dataset.provider === 'spotify') {
          const spotifyUrl = new URL(slot.dataset.src);
          spotifyUrl.pathname = spotifyUrl.pathname.replace('/embed/', '/');
          spotifyUrl.search = '';
          const link = document.createElement('a');
          const play = document.createElement('span');
          link.className = 'spotify-link';
          link.href = spotifyUrl.toString();
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.setAttribute('aria-label', `Listen to ${slot.dataset.title} on Spotify`);
          play.className = 'spotify-play';
          link.append(play);
          slot.append(link);
          return;
        }
        if (slot.dataset.provider === 'apple') {
          const frame = document.createElement('iframe');
          const player = document.createElement('span');
          player.className = 'embedded-player apple';
          frame.src = slot.dataset.src;
          frame.title = `${slot.dataset.title} on Apple Music`;
          frame.allow = 'autoplay *; encrypted-media *; fullscreen *; clipboard-write';
          player.append(frame);
          slot.append(player);
          return;
        }
        if (slot.dataset.provider === 'atmos') {
          const view = document.createElement('div');
          const halo = document.createElement('span');
          const artwork = document.createElement('img');
          const appleLink = document.createElement('a');
          const appleMark = document.createElement('span');
          const playMark = document.createElement('span');
          view.className = 'atmos-view';
          view.style.setProperty('--atmos-art', `url("${slot.dataset.image}")`);
          halo.className = 'atmos-halo';
          artwork.className = 'atmos-artwork';
          artwork.src = slot.dataset.image;
          artwork.alt = '';
          appleLink.className = 'atmos-apple-link';
          appleLink.href = slot.dataset.src;
          appleLink.target = '_blank';
          appleLink.rel = 'noopener noreferrer';
          appleLink.setAttribute('aria-label', `Listen to ${slot.dataset.title} in Apple Music`);
          appleMark.className = 'atmos-apple-mark';
          appleMark.textContent = '\uf8ff';
          playMark.className = 'atmos-play-mark';
          appleLink.append(appleMark, playMark);
          view.append(halo, artwork, appleLink);
          slot.append(view);
          return;
        }
        const frame = document.createElement('iframe');
        const player = document.createElement('span');
        player.className = 'embedded-player bandcamp';
        frame.src = slot.dataset.src.replace('/transparent=true/', '/tracklist=false/artwork=large/transparent=true/');
        frame.title = `${slot.dataset.title} audio`;
        frame.allow = 'encrypted-media; picture-in-picture';
        player.append(frame);
        const mediaFace = slot.closest('.media-face');
        if (mediaFace?.dataset.hasNext === 'true') {
          const advance = document.createElement('button');
          advance.type = 'button';
          advance.className = 'media-turn';
          advance.setAttribute('aria-label', `Show next media for ${slot.dataset.title}`);
          advance.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            const cube = slot.closest('.slice');
            if (cube) setCubePosition(cube, 4);
          });
          slot.append(advance, player);
          return;
        }
        slot.append(player);
      }

      function loadMediaAfterRotation(cube, position) {
        window.clearTimeout(mediaLoadTimers.get(cube));
        const delay = reduceMotion ? 0 : 430;
        const timer = window.setTimeout(() => {
          const isStillShowing = (position === 3 && cube.classList.contains('is-media-1'))
            || (position === 4 && cube.classList.contains('is-media-2'));
          if (!isStillShowing) return;
          const slot = cube.querySelector(`.media-slot[data-position="${position}"]`);
          if (slot) mountEmbed(slot);
        }, delay);
        mediaLoadTimers.set(cube, timer);
      }

      function setCubePosition(cube, position) {
        cubes.forEach((item) => { if (item !== cube) resetCube(item); });
        window.clearTimeout(mediaLoadTimers.get(cube));
        cube.classList.remove(...positions);
        cube.querySelectorAll('.media-slot').forEach(clearSlot);
        if (position === 2) cube.classList.add('is-info');
        if (position === 3) {
          cube.classList.add('is-media-1');
          if (cube.dataset.atmos === 'true') cube.classList.add('is-atmos');
        }
        if (position === 4) cube.classList.add('is-media-2');
        if (position > 2) loadMediaAfterRotation(cube, position);
        lockCube(cube);
      }

      function animate(element, keyframes, duration) {
        if (reduceMotion) return Promise.resolve();
        return element.animate(keyframes, {
          duration,
          easing: 'cubic-bezier(.2,.82,.18,1)',
          fill: 'both',
        }).finished.catch(() => undefined);
      }

      async function filterProjects(nextFilter) {
        if (isFiltering) return;
        isFiltering = true;

        const nextVisible = new Set(nextFilter === 'all'
          ? cubes
          : cubes.filter((cube) => cube.dataset.categories.split(' ').includes(nextFilter)));
        const exiting = cubes.filter((cube) => !cube.hidden && !nextVisible.has(cube));

        resetProjects();
        await Promise.all(exiting.map((cube) => animate(cube, [
          { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
          { opacity: 0, transform: 'translate3d(0, 1.15rem, 0) scale(.9)' },
        ], 150)));
        exiting.forEach((cube) => { cube.hidden = true; });

        const retained = cubes.filter((cube) => !cube.hidden && nextVisible.has(cube));
        const before = new Map(retained.map((cube) => [cube, cube.getBoundingClientRect()]));
        const entering = [...nextVisible].filter((cube) => cube.hidden);
        entering.forEach((cube) => {
          cube.hidden = false;
          cube.style.visibility = 'hidden';
        });

        const moves = retained.map((cube) => {
          const start = before.get(cube);
          const end = cube.getBoundingClientRect();
          return animate(cube, [
            { transform: `translate3d(${start.left - end.left}px, ${start.top - end.top}px, 0)` },
            { transform: 'translate3d(0, 0, 0)' },
          ], 400);
        });
        const arrivals = entering.map((cube) => {
          cube.style.visibility = '';
          return animate(cube, [
            { opacity: 0, transform: 'translate3d(0, 1rem, 0) scale(.9)' },
            { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
          ], 360);
        });

        await Promise.all([...moves, ...arrivals]);
        isFiltering = false;
      }

      document.querySelector('.filter-nav').addEventListener('click', (event) => {
        const filterButton = event.target.closest('[data-filter]');
        if (!filterButton || isFiltering) return;
        const requestedFilter = filterButton.dataset.filter;
        const nextFilter = requestedFilter === activeFilter && requestedFilter !== 'all' ? 'all' : requestedFilter;
        document.querySelectorAll('[data-filter]').forEach((button) => {
          const isActive = button.dataset.filter === nextFilter;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
        activeFilter = nextFilter;
        filterProjects(nextFilter);
      });

      cubes.forEach((cube) => {
        const front = cube.querySelector('.front');
        const info = cube.querySelector('.right');
        const mediaAdvance = cube.querySelector('.media-advance');
        cube.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('.video-expand')) return;
          if (lockedCubes.has(cube)) {
            event.preventDefault();
            event.stopPropagation();
            return;
          }
          if (cube.classList.contains('is-info')
            && !Number(info.dataset.mediaCount)
            && target.closest('.right')) {
            event.stopPropagation();
            resetCube(cube);
            return;
          }
          if (cube.classList.contains('is-media-2')) {
            event.stopPropagation();
            resetCube(cube);
          }
        }, { capture: true });
        front.addEventListener('click', () => {
          if (!lockedCubes.has(cube)) setCubePosition(cube, 2);
        });
        info.addEventListener('click', () => {
          if (lockedCubes.has(cube)) return;
          if (!cube.classList.contains('is-info')) {
            setCubePosition(cube, 2);
            return;
          }
          if (Number(info.dataset.mediaCount)) {
            setCubePosition(cube, 3);
          } else {
            resetCube(cube);
          }
        });
        mediaAdvance?.addEventListener('click', () => {
          if (lockedCubes.has(cube)) return;
          if (Number(info.dataset.mediaCount)) {
            setCubePosition(cube, 3);
          } else {
            resetCube(cube);
          }
        });
        const firstMediaFace = cube.querySelector('.media-face[data-position="3"]');
        firstMediaFace.addEventListener('click', (event) => {
          if (lockedCubes.has(cube)) return;
          if (event.target.closest('.embedded-player, .video-expand, .spotify-link, .atmos-apple-link')) return;
          if (firstMediaFace.dataset.hasNext === 'true') {
            setCubePosition(cube, 4);
          } else {
            resetCube(cube);
          }
        });
      });

      main.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const cube = target.closest('.slice');
        if (cube) return;
        if (target.closest('.filter-nav')) return;
        resetProjects();
      }, { capture: true });
    </script>
  </body>
</html>
